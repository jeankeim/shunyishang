FROM node:20-alpine AS base

# 安装依赖（国内 npmmirror 加速）
FROM base AS deps
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --registry=https://registry.npmmirror.com

# 构建
FROM base AS builder
WORKDIR /app
# NEXT_PUBLIC_* 变量在构建时内联进客户端代码，必须通过 build-arg 传入
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_OSS_IMAGES_URL
ARG NEXT_PUBLIC_R2_PUBLIC_URL
ARG NEXT_PUBLIC_APP_NAME=五行智能衣橱
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_OSS_IMAGES_URL=$NEXT_PUBLIC_OSS_IMAGES_URL \
    NEXT_PUBLIC_R2_PUBLIC_URL=$NEXT_PUBLIC_R2_PUBLIC_URL \
    NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web/ .
# 删除本地开发环境文件，避免覆盖 build-arg 注入的配置
RUN rm -f .env.local .env.development.local .env.production.local
RUN npm run build

# 生产运行 - 使用完整 next start 模式（更稳定）
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

# 复制构建产物和依赖
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/next.config.js ./next.config.js

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["npx", "next", "start", "-p", "3000", "-H", "0.0.0.0"]
