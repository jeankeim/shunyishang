FROM node:20-alpine AS base

# 海报字体子集化（Satori 出图需内嵌 CJK 衬线字体）
FROM python:3.11-slim AS fonts
WORKDIR /work
RUN apt-get update && apt-get install -y --no-install-recommends fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir fonttools
COPY scripts/extract_poster_font.py ./scripts/
RUN python scripts/extract_poster_font.py

# 安装依赖
FROM base AS deps
WORKDIR /app
COPY apps/web/package.json ./
RUN npm install --production=false

# 构建
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web/ .
# Satori 海报字体与质感资产（服务端出图使用）
COPY --from=fonts /work/apps/web/public/fonts ./public/fonts
COPY data/standards/poster_assets ./poster_assets
RUN npm run build

# 生产运行 - 使用完整 next start 模式（更稳定）
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

# 复制构建产物和依赖
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/next.config.js ./next.config.js
COPY --from=builder /app/poster_assets ./poster_assets

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["npx", "next", "start", "-p", "3000", "-H", "0.0.0.0"]
