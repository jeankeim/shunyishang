# === 数据库配置 ===
DATABASE_URL=postgresql://wuxing_user:wuxing_password@localhost:5432/wuxing_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# === AI 模型配置 ===
# OpenAI (备用)
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# 阿里百炼千问 (主要 LLM) —— 国内端点（杭州），ECS 内网低延迟免流量
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_FLASH_MODEL=qwen-flash
# 多模态视觉模型（拍照识别衣物五行属性）
QWEN_VL_MODEL=qwen-vl-plus

# Embedding 模型
EMBEDDING_MODEL=BGE-M3
EMBEDDING_DIMENSION=1024

# === JWT 配置 ===
# 生产环境必须设置！使用以下命令生成：
# openssl rand -base64 32
JWT_SECRET_KEY=your-production-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# === Redis 缓存配置 ===
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
CACHE_TTL_BAZI=86400
CACHE_TTL_WEATHER=900
CACHE_TTL_SEARCH=3600

# === Upstash Redis（海外生产环境，迁移国内后可移除）===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Cloudflare R2 对象存储（海外生产环境，迁移国内后可移除）===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=wuxing-wardrobe
R2_PUBLIC_URL=

# === 阿里云 OSS 对象存储（国内生产环境）===
# 迁移到阿里云后填写以下配置，R2 配置可留空
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=shunyishang-images

# === 后台管理模块 ===
# 管理员白名单：users.user_code 逗号分隔（留空则无人可访问 /admin）
ADMIN_USER_CODES=
# 阿里云账单查询 AK（建议 RAM 子账号，仅授予 AliyunBSSReadOnlyAccess 只读权限）
ALIYUN_BILLING_ACCESS_KEY_ID=
ALIYUN_BILLING_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_PUBLIC_URL=

# === 短信验证码（阿里云号码认证服务-短信认证，个人备案免资质）===
# 功能开关：关闭时开发环境不真实发送，核验固定码 123456；生产开启设为 true
SMS_ENABLED=false
# 凭证二选一：显式 AK/SK（RAM 用户）或留空走默认凭证链（ECS 实例 RAM 角色）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 控制台获取的系统赠送签名与验证码模板编号
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# === 应用配置 ===
APP_ENV=development  # development | production
APP_DEBUG=true
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
# 生产环境必须设置具体域名，禁止使用通配符
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === 天气API配置 ===
# 和风天气API Key (免费版: https://dev.qweather.com/)
WEATHER_API_KEY=your-qweather-api-key-here
# 高德地图API Key (用于逆地理编码)
AMAP_API_KEY=your-amap-api-key-here

# ============================================================
# API 限流 / LLM 日配额（防刷接口、控制 DashScope 费用）
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=120   # 全局：每 IP 每分钟最大请求数
RATE_LIMIT_AUTH_PER_MINUTE=5       # 登录/注册：每 IP 每分钟最大次数
LLM_QUOTA_ENABLED=true
LLM_DAILY_QUOTA=30                 # 每身份（登录用户/游客IP）每日 AI 推荐次数

# ============================================================
# PII 敏感字段加密（出生日期/时辰/出生地，PIPL 合规）
# ⚠️ 未配置时系统不报错，而是静默降级为明文入库（仅记一次 warning），
#    生产环境必须配置！生成：python -m apps.api.core.pii_crypto genkey
#    密钥严禁提交 Git、严禁外传；唯一副本需离线备份，丢失则存量密文永久不可解。
#    配好后对存量明文数据回填：python scripts/encrypt_existing_pii.py --dry-run
# ============================================================
PII_ENCRYPTION_KEY=

# ============================================================
# Sentry 错误监控（留空则不启用）
# ============================================================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1      # 性能跟踪采样率，免费额度有限保持低采样
