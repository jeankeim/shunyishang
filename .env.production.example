# ============================================================
# 顺衣尚 · 生产环境配置模板（阿里云国内部署 · 方案B）
# 复制为 .env.production 并填入真实值（切勿提交真实密钥到 Git）
# ============================================================

# === 数据库（阿里云 RDS PostgreSQL 内网地址） ===
DATABASE_URL=postgresql://YOUR_RDS_USER:YOUR_RDS_PASSWORD@YOUR_RDS_HOST.rds.aliyuncs.com:5432/YOUR_RDS_DB
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# === 阿里百炼千问 LLM（国内端点，杭州，低延迟） ===
DASHSCOPE_API_KEY=sk-YOUR_DOMESTIC_DASHSCOPE_API_KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# === Embedding 配置 ===
EMBEDDING_MODEL=BGE-M3
EMBEDDING_DIMENSION=1024

# === 应用配置 ===
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
FRONTEND_URL=https://shunyishang.cn

# === CORS（方案B关键：前端静态导出后跨域直连，必须配具体域名，禁止 *） ===
CORS_ORIGINS=https://shunyishang.cn,https://www.shunyishang.cn

# === JWT（生产环境强随机，>=32位且含字母数字；openssl rand -base64 32） ===
JWT_SECRET_KEY=YOUR_STRONG_RANDOM_SECRET_KEY_HERE

# === 天气 API ===
WEATHER_API_KEY=YOUR_QWEATHER_API_KEY
AMAP_API_KEY=YOUR_AMAP_API_KEY

# === 阿里云 OSS 对象存储（配置后自动启用，替代 Cloudflare R2） ===
OSS_ACCESS_KEY_ID=YOUR_OSS_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=YOUR_OSS_ACCESS_KEY_SECRET
OSS_BUCKET_NAME=shunyishang-images

# === 后台管理模块 ===
# 管理员白名单：users.user_code 逗号分隔（留空则无人可访问 /admin）
ADMIN_USER_CODES=
# 阿里云账单查询 AK（建议 RAM 子账号，仅授予 AliyunBSSReadOnlyAccess 只读权限）
ALIYUN_BILLING_ACCESS_KEY_ID=
ALIYUN_BILLING_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_PUBLIC_URL=https://images.shunyishang.cn

# === 阿里云 Redis 缓存（配置后自动启用，替代 Upstash） ===
REDIS_URL=redis://YOUR_REDIS_USER:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST.rds.aliyuncs.com:6379/0
REDIS_ENABLED=true

# ============================================================
# API 限流 / LLM 日配额（防刷接口、控制 DashScope 费用）
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=120     # 全局：每 IP 每分钟最大请求数
RATE_LIMIT_AUTH_PER_MINUTE=5         # 登录/注册：每 IP 每分钟最大次数
LLM_QUOTA_ENABLED=true
LLM_DAILY_QUOTA=30                   # 每身份（登录用户/游客IP）每日 AI 推荐次数

# ============================================================
# PIPL 敏感字段加密（出生日期/时辰/地点 应用层加密落库）
# 生成密钥: .venv/bin/python -m apps.api.core.pii_crypto genkey
# ⚠️ 生产必须配置；密钥丢失将导致存量密文无法解密，请妥善备份
# 存量数据回填: .venv/bin/python scripts/encrypt_existing_pii.py
# ============================================================
PII_ENCRYPTION_KEY=

# ============================================================
# 错误监控（Sentry 免费版：https://sentry.io 注册后创建 Python/FastAPI 项目获取 DSN）
# 留空则不启用；上线首周建议开启邮件告警（Sentry 后台 Alerts 默认规则即可）
# ============================================================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1    # 性能追踪采样率，免费额度有限保持低采样

# ============================================================
# 以下为海外旧配置，迁移完成后可删除（已被上方国内服务替代）
# ============================================================
# --- Cloudflare R2（已被 OSS 替代） ---
# R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
# R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
# R2_BUCKET_NAME=wuxing-wardrobe
# R2_PUBLIC_URL=https://pub-YOUR_R2_PUBLIC_ID.r2.dev
#
# --- Upstash Redis（已被阿里云 Redis 替代） ---
# UPSTASH_REDIS_REST_URL=https://YOUR_REDIS_DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_REDIS_TOKEN
